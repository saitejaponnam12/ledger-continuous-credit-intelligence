# ============================================================
# LEDGER — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development                  # development | production
APP_SECRET_KEY=change-me-to-a-random-64-char-secret
DEBUG=true
LOG_LEVEL=INFO

# --- JWT ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ledger:ledger_pass@localhost:5432/ledger_db
DATABASE_URL_SYNC=postgresql+psycopg2://ledger:ledger_pass@localhost:5432/ledger_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- pgvector ---
VECTOR_DIMENSIONS=384

# --- LLM (Ollama - local, no API key needed) ---
LLM_PROVIDER=ollama                  # ollama | mock | future_cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

# --- Demo / Mock mode ---
DEMO_MODE=false                      # Set true to use MockProvider (no Ollama needed)
DEMO_CACHE_DIR=data/demo_cache

# --- Embeddings (local sentence-transformers, no API key) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- ML ---
MODEL_PATH=ml/models/xgb_credit_model.pkl
CALIBRATOR_PATH=ml/models/isotonic_calibrator.pkl
FEATURE_VERSION=v1.0
MODEL_VERSION=xgb-v1.0

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_COPILOT=10/minute
RATE_LIMIT_EVENTS=20/minute

# --- Quantum (optional stretch goal) ---
ENABLE_QUANTUM=false

# --- Demo credentials (seeded users — change in production) ---
DEMO_UNDERWRITER_EMAIL=sarah.chen@ledger.demo
DEMO_UNDERWRITER_PASSWORD=LedgerDemo2026!
DEMO_ADMIN_EMAIL=admin@ledger.demo
DEMO_ADMIN_PASSWORD=LedgerAdmin2026!
